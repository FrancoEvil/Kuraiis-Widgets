{
  "name": "kuraiis-widgets",
  "version": "1.6.0",
  "description": "Kuraii's Widgets · Música y chat de TikTok LIVE para OBS y LIVE Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test": "playwright test --workers=1",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "keywords": [],
  "author": "Kuraii",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Kuraii's Widgets",
  "build": {
    "appId": "studio.nowplaying.desktop",
    "asar": true,
    "files": [
      "src/**/*",
      "ui/**/*",
      "scripts/media.ps1",
      "package.json",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "scripts/media.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "assets/app.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Kuraiis-Widgets-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Kuraiis-Widgets-Portable-${version}.${ext}"
    },
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "FrancoEvil",
        "repo": "Kuraiis-Widgets",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tiktok-live-connector": "^2.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancoEvil/Kuraiis-Widgets.git"
  },
  "homepage": "https://github.com/FrancoEvil/Kuraiis-Widgets"
}